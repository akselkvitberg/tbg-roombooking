msgstr "Utenfor åpningstid"

#. translators: 1: room or date, 2: time range, 3: status, 4: what happens when chosen
#: build/creoRombookingPublic.js:2
msgid "%1$s, %2$s, %3$s. %4$s"
msgstr "%1$s, %2$s, %3$s. %4$s"

#: build/creoRombookingPublic.js:2
msgid "Choose to see details."
msgstr "Velg for detaljer."

#: build/creoRombookingPublic.js:2
msgid "Your request is waiting for approval. Choose to see details."
msgstr "Forespørselen din venter på godkjenning. Velg for detaljer."

#: build/creoRombookingPublic.js:2
msgid "This time has passed."
msgstr "Tiden har passert."

#: build/creoRombookingPublic.js:2
msgid "Choose to book."
msgstr "Velg for å booke."

#: build/creoRombookingPublic.js:2
msgid "Choose to send a request to the administrator."
msgstr "Velg for å sende forespørsel til admin."

#: build/creoRombookingPublic.js:2
msgid "Waiting for approval. Choose to send your own request to the administrator."
msgstr "Venter på godkjenning. Velg for å sende egen forespørsel til admin."

#. translators: %d: number of people the room fits
#: build/creoRombookingPublic.js:3
msgid "%d place"
msgid_plural "%d places"
msgstr[0] "%d plass"
msgstr[1] "%d plasser"

#: build/creoRombookingPublic.js:3
msgid "approval"
msgstr "godkjenning"

#: build/creoRombookingPublic.js:3
msgid "automatic"
msgstr "auto"

#. translators: %s: date, e.g. «wednesday 23 September»
#: build/creoRombookingPublic.js:4
msgid "Rooms and times, %s"
msgstr "Rom og tider, %s"

#: build/creoRombookingPublic.js:4
msgid "Legend"
msgstr "Forklaring"

#. translators: 1: room name, 2: date
#: build/creoRombookingPublic.js:5
msgid "Times in %1$s, %2$s"
msgstr "Tider i %1$s, %2$s"

#: build/creoRombookingPublic.js:5
msgid "Choose date"
msgstr "Velg dato"

#: build/creoRombookingPublic.js:5
msgid "Previous day"
msgstr "Forrige dag"

#: build/creoRombookingPublic.js:5
msgid "Next day"
msgstr "Neste dag"

#: build/creoRombookingPublic.js:5
msgid "Today"
msgstr "I dag"

#: build/creoRombookingPublic.js:5
msgid "View"
msgstr "Visning"

#: build/creoRombookingPublic.js:5
msgid "Day"
msgstr "Dag"

#: build/creoRombookingPublic.js:5
msgid "Week"
msgstr "Uke"

#: build/creoRombookingPublic.js:5
msgid "Choose an available time to book. With a keyboard: the up and down arrows move, Home and End go to the first and last time, Page Up and Page Down change day, and Enter opens."
msgstr "Velg en ledig tid for å booke. Med tastatur: pil opp og ned flytter, Home og End går til første og siste tid, Page Up og Page Down bytter dag, og Enter åpner."

#: build/creoRombookingPublic.js:5
msgid "Choose an available time to book. With a keyboard: the arrow keys move, Home and End go to the start and end of the row, Page Up and Page Down change day, and Enter opens."
msgstr "Velg en ledig tid for å booke. Med tastatur: piltastene flytter, Home og End går til start og slutt på raden, Page Up og Page Down bytter dag, og Enter åpner."

#: build/creoRombookingPublic.js:5
msgid "Week view"
msgstr "Ukevisning"

#: build/creoRombookingPublic.js:5
msgid "The week view comes in a later version."
msgstr "Ukevisningen kommer i en senere versjon."

#: build/creoRombookingPublic.js:5
msgid "Could not load available times."
msgstr "Kunne ikke laste ledige tider."

#: build/creoRombookingPublic.js:5
msgid "Try again"
msgstr "Prøv igjen"

#: build/creoRombookingPublic.js:5
msgid "Loading available times…"
msgstr "Laster ledige tider …"

#: build/creoRombookingPublic.js:5
msgid "There are no rooms to book yet."
msgstr "Det er ingen rom å booke ennå."
