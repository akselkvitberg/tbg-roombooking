msgid "Room booking"
msgstr "Rombooking"

#: blocks/app/block.json
msgctxt "block description"
msgid "Room booking for members, with requests and conflict handling for administrators."
msgstr "Rombooking for medlemmer, med forespørsler og konflikthåndtering for administratorer."

#: includes/class-creo-rombooking-rest.php:85
msgid "Room booking is only available to members."
msgstr "Rombooking er bare tilgjengelig for medlemmer."

#: includes/class-creo-rombooking-rest.php:95
msgid "Only administrators can do this."
msgstr "Bare administratorer kan gjøre dette."

#: includes/class-creo-rombooking-rest.php:117
msgid "The date must be in the format YYYY-MM-DD."
msgstr "Datoen må ha formatet ÅÅÅÅ-MM-DD."

#: includes/class-creo-rombooking-rest.php:176
msgid "The last date must be on or after the first date."
msgstr "Sluttdatoen kan ikke være før startdatoen."

#. translators: %d: number of days
#: includes/class-creo-rombooking-rest.php:183
msgid "You can get at most %d days at a time."
msgstr "Du kan hente maks %d dager om gangen."

