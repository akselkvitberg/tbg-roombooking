msgstr "Din booking"

#: build/creoRombookingPublic.js:1
msgid "New booking"
msgstr "Ny booking"

#: build/creoRombookingPublic.js:1
msgid "This time is booked"
msgstr "Tidsrommet er opptatt"

#: build/creoRombookingPublic.js:1
msgid "Your request goes to the administrator, who decides whether it can be approved. You get a text message with the answer."
msgstr "Forespørselen sendes til admin, som avgjør om den kan godkjennes. Du får SMS med svaret."

#: build/creoRombookingPublic.js:1
#: build/creoRombookingPublic.js:4
