#. Plugin Name of the plugin
#: creo-rombooking.php
msgid "Creo Rombooking"
msgstr "Creo Rombooking"

#. Description of the plugin
#: creo-rombooking.php
#: build/creoRombookingEditor.js:1
msgid "Room booking for members, with requests and conflict handling for administrators."
msgstr "Rombooking for medlemmer, med forespørsler og konflikthåndtering for administratorer."

#. Author of the plugin
#: creo-rombooking.php
msgid "Creo Multiservice AS"
msgstr "Creo Multiservice AS"

