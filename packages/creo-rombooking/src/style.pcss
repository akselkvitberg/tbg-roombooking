@tailwind components;
@tailwind utilities;

/*
 * The app is placed inside the theme's `.prose` content. `not-prose` on the
 * root opts out of the typography styles, and all rules below are scoped to
 * `.creo-rombooking` so they win over the theme's `.prose a[href]` links.
 */
.creo-rombooking {
	box-sizing: border-box;
	max-width: 1100px;
	margin-left: auto;
	margin-right: auto;

	& *,
	& *::before,
	& *::after {
		box-sizing: border-box;
	}

	/* One visible focus style for all controls, in the theme's colors. */
	& :focus {
		outline: none;
	}

	& :focus-visible {
		outline: 2px solid var(--wp--preset--color--dark-green);
		outline-offset: 2px;
	}

	& .creo-rombooking-button,
	& a.creo-rombooking-button[href] {
		@apply inline-flex cursor-pointer items-center whitespace-nowrap rounded-full border-2 border-transparent px-3 py-1.5 text-sm font-medium no-underline transition-colors;
		@apply text-white bg-dark-green hover:bg-dark-green-80 dark:text-black dark:bg-light-green dark:hover:bg-light-green-80;
	}

	& .creo-rombooking-notice {
		@apply rounded border border-solid border-gray-300 bg-white p-6 dark:border-gray-600 dark:bg-slate-800;
	}

	& .creo-rombooking-notice > p {
		@apply m-0;
	}

	& .creo-rombooking-notice > p + p {
		@apply mt-4;
	}

	& .creo-rombooking-loading {
		@apply m-0 py-8 text-center text-gray-600 dark:text-gray-400;
	}

	& .creo-rombooking-tabs {
		@apply mb-6 flex flex-wrap gap-1 border-0 border-b border-solid border-gray-300 dark:border-gray-600;
	}

	& .creo-rombooking-tab {
		@apply -mb-px cursor-pointer border-0 border-b-2 border-solid border-transparent bg-transparent px-3 py-2 text-sm font-medium text-gray-700 dark:text-gray-300;
		@apply hover:text-dark-green dark:hover:text-light-green;

		&.is-selected {
			@apply border-dark-green text-dark-green dark:border-light-green dark:text-light-green;
		}
	}

	& .creo-rombooking-empty {
		@apply rounded border border-dashed border-gray-300 px-6 py-12 text-center dark:border-gray-600;
	}

	& .creo-rombooking-empty-title {
		@apply m-0 text-lg font-semibold;
	}

	& .creo-rombooking-empty-text {
		@apply mt-1 text-gray-600 dark:text-gray-400;
	}
}

.dark .creo-rombooking :focus-visible {
	outline-color: var(--wp--preset--color--light-green);
}
