{
  "compilerOptions": {
    "strict": true,
    "module": "ESNext",
    "target": "ESNext",
    "jsx": "react-jsx",
    "lib": ["DOM", "ESNext"],
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@creo-wp/*": ["./tools/*"]
    }
  },
  "exclude": ["node_modules", "vendor", "vendor-theme", ".tmp", "packages/*/build"]
}
