<?xml version="1.0"?>
<ruleset name="Creo WordPress Standards">
	<description>PHP coding standards for WordPress plugins and themes.</description>

	<file>./packages</file>
	<file>./tests/phpunit</file>
	<exclude-pattern>./packages/*/build/*</exclude-pattern>

	<arg value="sp"/>
	<arg name="colors"/>
	<arg name="parallel" value="8"/>
	<arg name="basepath" value="./" />
	<arg name="extensions" value="php"/>

	<config name="testVersion" value="8.2-"/>
	<config name="minimum_supported_wp_version" value="6.4" />

	<rule ref="PHPCompatibilityWP"/>
	<rule ref="WordPress-Core">
		<exclude name="Generic.CodeAnalysis.AssignmentInCondition"/>
		<exclude name="Generic.CodeAnalysis.UnusedFunctionParameter.FoundAfterLastUsed"/>
		<exclude name="Squiz.PHP.CommentedOutCode"/>
		<exclude name="Squiz.PHP.DisallowMultipleAssignments.FoundInControlStructure"/>
		<exclude name="Universal.Operators.DisallowShortTernary"/>
		<exclude name="WordPress.PHP.NoSilencedErrors.Discouraged"/>
		<exclude name="WordPress.PHP.YodaConditions.NotYoda"/>
		<exclude name="WordPress.WP.I18n.MissingTranslatorsComment"/>
		<exclude name="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedHooknameFound"/>
	</rule>
	<!-- <rule ref="WordPress-Docs"/> -->
	<rule ref="WordPress-Extra"/>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array" value="creo_rombooking" />
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array" value="default,creo-rombooking" />
		</properties>
	</rule>

	<rule ref="WordPress.Security.EscapeOutput">
		<properties>
			<property name="customAutoEscapedFunctions" type="array" value="get_language_attributes"/>
		</properties>
	</rule>

	<rule ref="WordPress.WP.GlobalVariablesOverride.Prohibited">
		<exclude-pattern>packages/*/template-parts/*</exclude-pattern>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>packages/*/template-parts/*</exclude-pattern>
	</rule>

	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<exclude-pattern>tests/phpunit/*</exclude-pattern>
	</rule>
</ruleset>
